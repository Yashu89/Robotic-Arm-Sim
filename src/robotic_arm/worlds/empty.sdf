<?xml version="1.0" ?>
<sdf version="1.9">

  <world name="default">

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors"/>

    <gravity>0 0 -9.81</gravity>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="red_cube">
      <static>false</static>

      <pose>0.5 -0.6 0.025 0 0 0</pose>

      <link name="link">

        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>

          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>2.0</mu>
                <mu2>2.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00003</ixx>
            <iyy>0.00003</iyy>
            <izz>0.00003</izz>
          </inertia>
        </inertial>

      </link>
    </model>

    <model name="basket">
      <static>true</static>

  <!-- Basket center position -->
      <pose>-0.8 0.3 0.0 0 0 0</pose>

    <!-- Bottom -->
      <link name="bottom">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 0.2 0.02</size>
            </box>
          </geometry>
          <pose>0 0 0.01 0 0 0</pose>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 0.2 0.02</size>
            </box>
          </geometry>
          <pose>0 0 0.01 0 0 0</pose>
        </visual>
      </link>

  
      <link name="left_wall">
        <pose>0 0.1 0.075 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 0.02 0.15</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.20 0.02 0.15</size>
            </box>
          </geometry>
        </visual>
      </link>

      <link name="right_wall">
        <pose>0 -0.1 0.075 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 0.02 0.15</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.20 0.02 0.15</size>
            </box>
          </geometry>
        </visual>
      </link>

  
      <link name="front_wall">
        <pose>0.1 0 0.075 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.02 0.20 0.15</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.02 0.20 0.15</size>
            </box>
          </geometry>
        </visual>
      </link>

      <link name="back_wall">
        <pose>-0.1 0 0.075 0 0 0</pose>
          <collision name="collision">
            <geometry>
              <box>
                <size>0.02 0.20 0.15</size>
              </box>
            </geometry>
          </collision>
          <visual name="visual">
            <geometry>
              <box>
                <size>0.02 0.20 0.15</size>
              </box>
            </geometry>
          </visual>
      </link> -->

    </model>

  </world>

</sdf>